@{
    ViewData["Title"] = "Create New Department";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Create New Department</h3>
                </div>

                <div class="card-body">

                    <form method="post" asp-controller="Department" asp-action="Save">

                        <div class="mb-3">
                            <label for="name" class="form-label">Department Name</label>
                            <input type="text"
                                   class="form-control"
                                   id="name"
                                   name="name"
                                   value="@Model?.Name"
                                   placeholder="Enter department name" />
                        </div>

                        <div class="mb-4">
                            <label for="ManagerName" class="form-label">Manager Name</label>
                            <input type="text"
                                   class="form-control"
                                   id="ManagerName"
                                   name="ManagerName"
                                   value="@Model?.ManagerName"
                                   placeholder="Enter manager name" />
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                Create Department
                            </button>

                            <a asp-controller="Department"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Back to List
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>