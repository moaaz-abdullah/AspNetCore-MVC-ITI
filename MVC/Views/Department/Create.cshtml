@{
    ViewData["Title"] = "Create New Department";
}

<h1>@ViewData["Title"]</h1>

<form method="GET" action="/Department/Save">
    <div>
        <label for="name">Department Name</label>
        <input type="text" value="@Model?.Name" class="form-control" id="name" name="name">
    </div>

    <div>
        <label for="ManagerName">Manager Name</label>
        <input type="text" value="@Model?.ManagerName" class="form-control" id="ManagerName" name="ManagerName">
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
</form>

<a href="/Department/Index" class="btn btn-secondary">Back to List</a>