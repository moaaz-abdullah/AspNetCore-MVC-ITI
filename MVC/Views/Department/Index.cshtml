@model List<Department>

@{
    ViewData["Title"] = "Departments Index";
}

<h1>Index</h1>

<table class="table table-hover table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var department in Model)
        {
            <tr>
                <td>@department.ID</td>
                <td>@department.Name</td>
            </tr>
        }
    </tbody>
</table>