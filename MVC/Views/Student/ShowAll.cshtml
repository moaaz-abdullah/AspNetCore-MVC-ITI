@model List<Student>
<table class="table table-bordered table-hover">

    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Image</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td><img src="/Images/@student.ImageUrl" alt="@student.Name" style="width: 80px; height: auto;" /></td>
            </tr>
        }
    </tbody>
</table>