@model Employee

@{
    ViewData["Title"] = "Employee Details";
}

<h1>@ViewData["Title"]</h1>
<br />

<h2>@Model.Name</h2>
<h2>@ViewData["Message"]</h2>
<h2>@(int.Parse(ViewData["Temp"].ToString()) - 10)</h2>
<h2>@(string.Join(" - ", ViewData["Branches"] as IEnumerable<string>))</h2>
