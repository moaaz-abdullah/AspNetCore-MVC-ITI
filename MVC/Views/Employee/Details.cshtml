@model Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Employee Details</h3>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label class="fw-bold">Name</label>
                <div style="color:@ViewBag.Color">
                    @Model.Name
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Message</label>
                <div>
                    @ViewData["Message"]
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Temperature</label>
                <div>
                    @(Convert.ToInt32(ViewBag.Temp) - 10)
                </div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Branches</label>

                <select class="form-select">
                    @{
                        var branches = ViewData["Branches"] as IEnumerable<string>;
                    }

                    @if (branches != null)
                    {
                        foreach (var branch in branches)
                        {
                            <option>@branch</option>
                        }
                    }
                </select>
            </div>

        </div>

        <div class="card-footer">
            <a href="/Employee/Index" class="btn btn-secondary">
                Back
            </a>
        </div>
    </div>

</div>