@model EmployeeDebtColorTempVM

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container mt-4">

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Employee Details</h3>
        </div>

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">Employee Name</dt>
                <dd class="col-sm-9">@Model.EmpName</dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">@Model.DeptName</dd>

                <dt class="col-sm-3">Temperature</dt>
                <dd class="col-sm-9">@Model.Temp °C</dd>

                <dt class="col-sm-3">Message</dt>
                <dd class="col-sm-9">@Model.Message</dd>

                <dt class="col-sm-3">Color</dt>
                <dd class="col-sm-9">
                    <span class="fw-bold" style="color:@Model.Color">
                        @Model.Color
                    </span>
                </dd>

                <dt class="col-sm-3">Branches</dt>
                <dd class="col-sm-9">
                    <select class="form-select">
                        @foreach (var branch in Model.Branches)
                        {
                            <option>@branch</option>
                        }
                    </select>
                </dd>

            </dl>

        </div>

        <div class="card-footer">
            <a href="/Employee/Index" class="btn btn-secondary">
                Back
            </a>
        </div>
    </div>

</div>